extends ../layout

block content
  .container.mt-5
    .row.justify-content-center
      .col-lg-8
        .card.shadow-sm.border-0.rounded-3
          .card-header.bg-primary.text-white.py-3
            h4.mb-0 Agendar Nuevo Turno
          
          .card-body.p-4
            if error && error.length > 0
              .alert.alert-danger #{error}

            form(action="/turnos", method="POST")
              .mb-3
                label.form-label.fw-bold Paciente
                select.form-select(name="id_paciente", required)
                  option(value="", disabled, selected) Seleccionar Paciente
                  each paciente in pacientes
                    option(value=paciente.id_paciente) #{paciente.apellido}, #{paciente.nombre}

              .mb-3
                label.form-label.fw-bold Médico
                select.form-select(name="id_medico", required)
                  option(value="", disabled, selected) Seleccionar Médico
                  each medico in medicos
                    option(value=medico.id_medico) #{medico.apellido}, #{medico.nombre}

              .mb-3
                label.form-label.fw-bold Fecha y Hora
                input.form-control(type="datetime-local", name="fecha_hora", required)

              .mb-4
                label.form-label.fw-bold Estado
                select.form-select(name="estado", required)
                  option(value="confirmado") Confirmado
                  option(value="pendiente", selected) Pendiente
                  option(value="cancelado") Cancelado

              .d-flex.justify-content-end
                a.btn.btn-secondary.me-2(href="/turnos") Cancelar
                button.btn.btn-primary(type="submit") Guardar Turno