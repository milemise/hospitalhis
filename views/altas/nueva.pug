extends ../layout

block content
  .container.mt-4
    if error && error.length > 0
      .alert.alert-danger.alert-dismissible.fade.show
        | #{error}
        button.btn-close(type="button", data-bs-dismiss="alert")

    .card.shadow-sm.border-0.rounded-3
      .card-header.bg-success.text-white.py-3
        h4.mb-0 Generar Alta Médica
      
      .card-body.p-4
        .alert.alert-success
          strong Paciente: 
          | #{admision.paciente.nombre} #{admision.paciente.apellido}
        
        form(action="/altas/nueva/" + admision.id_admision, method="POST")
          .row.g-3
            .col-md-6
              label.form-label.fw-bold Médico que otorga el alta
              select.form-select(name="id_medico", required)
                option(value="", disabled, selected) Seleccionar...
                if medicos
                  each medico in medicos
                    option(value=medico.id_medico) #{medico.nombre} #{medico.apellido}
            
            .col-md-6
              label.form-label.fw-bold Condición del Alta
              select.form-select(name="tipo_alta", required)
                option(value="Alta Médica") Alta Médica Domiciliaria
                option(value="Traslado") Traslado a otra institución
                option(value="Alta Voluntaria") Alta Voluntaria (Fuga)
                option(value="Óbito") Óbito (Fallecimiento)
            
            .col-12
              label.form-label.fw-bold Epicrisis (Resumen de Internación e Indicaciones)
              textarea.form-control(name="resumen_epicrisis", rows="6", required, placeholder="Detallar evolución, procedimientos realizados, diagnóstico final e indicaciones a seguir...")
          
          .card-footer.bg-white.text-end.mt-4.pb-0.pe-0.border-0
            a.btn.btn-secondary.me-2(href="/admisiones/detalles/" + admision.id_admision) Cancelar
            button.btn.btn-success(type="submit") Confirmar Alta