extends ../layout

block content
  .container.mt-4
    if error && error.length > 0
      .alert.alert-danger.alert-dismissible.fade.show
        | #{error}
        button.btn-close(type="button", data-bs-dismiss="alert")

    .card.shadow-sm.border-0.rounded-3
      .card-header.bg-primary.text-white.py-3
        h4.mb-0 Registrar Evaluación y Signos Vitales
      
      .card-body.p-4
        .alert.alert-info
          strong Paciente: 
          | #{admision.paciente.nombre} #{admision.paciente.apellido} (DNI: #{admision.paciente.dni})
        
        form(action="/evaluaciones/nueva/" + admision.id_admision, method="POST")
          .row.g-3
            .col-md-6
              label.form-label.fw-bold Tipo de Evaluación
              select.form-select(name="tipo_evaluacion", required)
                option(value="", disabled, selected) Seleccionar...
                option(value="Enfermería") Control de Enfermería (Signos Vitales)
                option(value="Médica") Evolución Médica
            
            .col-md-6
              label.form-label.fw-bold Profesional a cargo
              select.form-select(name="id_medico")
                option(value="", selected) Seleccionar (Opcional si es personal de enfermería general)
                if medicos
                  each medico in medicos
                    option(value=medico.id_medico) #{medico.nombre} #{medico.apellido} - Mat. #{medico.matricula}
            
            .col-md-4
              label.form-label.fw-bold Temperatura (°C)
              input.form-control(type="number", step="0.1", name="temperatura", placeholder="Ej: 36.5")
            
            .col-md-4
              label.form-label.fw-bold Presión Arterial
              input.form-control(type="text", name="presion_arterial", placeholder="Ej: 120/80")
            
            .col-md-4
              label.form-label.fw-bold Frecuencia Cardíaca (lpm)
              input.form-control(type="number", name="frecuencia_cardiaca", placeholder="Ej: 75")
            
            .col-md-6
              label.form-label.fw-bold Frecuencia Respiratoria (rpm)
              input.form-control(type="number", name="frecuencia_respiratoria", placeholder="Ej: 16")
            
            .col-md-6
              label.form-label.fw-bold Saturación de Oxígeno (%)
              input.form-control(type="number", name="saturacion_oxigeno", placeholder="Ej: 98")
            
            .col-12
              label.form-label.fw-bold Observaciones y Notas de Evolución
              textarea.form-control(name="observaciones", rows="4", required)
          
          .card-footer.bg-white.text-end.mt-4.pb-0.pe-0.border-0
            a.btn.btn-secondary.me-2(href="/admisiones/detalles/" + admision.id_admision) Cancelar
            button.btn.btn-primary(type="submit") Guardar Evaluación