extends ../layout

block content
  .container.mt-4
    if error && error.length > 0
      .alert.alert-danger.alert-dismissible.fade.show
        | #{error}
        button.btn-close(type="button", data-bs-dismiss="alert")
    if success && success.length > 0
      .alert.alert-success.alert-dismissible.fade.show
        | #{success}
        button.btn-close(type="button", data-bs-dismiss="alert")

    .card.shadow-sm.border-0.rounded-3
      .card-header.bg-primary.text-white.py-3.d-flex.justify-content-between.align-items-center
        h4.mb-0 Detalles de Admisión ##{admision.id_admision}
        .btn-group
          if admision.estado_admision === 'Activo' || admision.estado_admision === 'En Proceso'
            a.btn.btn-warning(href="/admisiones/editar/" + admision.id_admision) 
              i.fas.fa-edit.me-1
              | Editar
            a.btn.btn-info(href="/evaluaciones/nueva/" + admision.id_admision) Registrar Evaluación
            a.btn.btn-success(href="/altas/nueva/" + admision.id_admision) Dar Alta
            form(action="/admisiones/cancelar/" + admision.id_admision, method="POST", style="display:inline;", onsubmit="return confirm('¿Seguro que desea cancelar esta admisión?');")
              button.btn.btn-danger(type="submit", style="border-radius: 0;") Cancelar
          a.btn.btn-secondary(href="/admisiones") Volver
      
      .card-body.p-4
        .row.g-4
          .col-md-6
            .card.h-100.border-0.bg-light
              .card-body
                h6.fw-bold.text-uppercase.border-bottom.pb-2 Información de Admisión
                p.mb-1 #[strong ID:] #{admision.id_admision}
                p.mb-1 #[strong Fecha de Ingreso:] #{new Date(admision.fecha_ingreso).toLocaleString('es-ES')}
                p.mb-1 #[strong Motivo:] #{admision.motivo_internacion}
                p.mb-1 #[strong Tipo:] #{admision.es_emergencia ? 'Emergencia' : 'Programada'}
                p.mb-0 #[strong Estado:] 
                  span.badge.bg-primary #{admision.estado_admision}
          
          .col-md-6
            .card.h-100.border-0.bg-light
              .card-body
                h6.fw-bold.text-uppercase.border-bottom.pb-2 Información del Paciente
                p.mb-1 #[strong Nombre:] #{admision.paciente.nombre} #{admision.paciente.apellido}
                p.mb-1 #[strong DNI:] #{admision.paciente.dni}
                p.mb-1 #[strong Obra Social:] #{admision.paciente.obraSocial ? admision.paciente.obraSocial.nombre : 'Particular'}
                p.mb-0 #[strong Grupo Sanguíneo:] #{admision.paciente.grupo_sanguineo || 'No registrado'}

        .card.mt-4.border-0.bg-light
          .card-body
            h6.fw-bold.text-uppercase.border-bottom.pb-2 Cama Asignada
            if admision.cama && admision.cama.habitacion
              p.mb-1 #[strong Ala:] #{admision.cama.habitacion.ala.nombre}
              p.mb-1 #[strong Habitación:] #{admision.cama.habitacion.numero}
              p.mb-0 #[strong Cama:] #{admision.cama.numero}
            else
              p.text-muted Sin asignar

        .card.mt-4.border-0
          .card-body.p-0
            h6.fw-bold.text-uppercase.border-bottom.pb-2.mb-3 Historial de Evaluaciones
            if admision.evaluaciones && admision.evaluaciones.length > 0
              .table-responsive
                table.table.table-bordered.align-middle
                  thead.table-light
                    tr
                      th Fecha
                      th Profesional
                      th Signos Vitales
                      th Observaciones
                  tbody
                    each ev in admision.evaluaciones
                      tr
                        td #{new Date(ev.fecha_evaluacion).toLocaleString('es-ES')}
                        td #{ev.medico ? ev.medico.nombre + ' ' + ev.medico.apellido : 'Enfermería'}
                        td
                          ul.list-unstyled.mb-0.small
                            if ev.temperatura
                              li Temp: #{ev.temperatura}°C
                            if ev.presion_arterial
                              li PA: #{ev.presion_arterial}
                            if ev.frecuencia_cardiaca
                              li FC: #{ev.frecuencia_cardiaca} lpm
                            if ev.saturacion_oxigeno
                              li SatO2: #{ev.saturacion_oxigeno}%
                        td #{ev.observaciones_medicas}
            else
              p.text-muted No hay evaluaciones registradas para esta admisión.