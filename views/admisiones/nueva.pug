extends ../layout

block content
  .container.my-4
    .row.justify-content-center
      .col-lg-10.col-xl-9
        .card.shadow-sm
          .card-header.py-3
            h1.h4.mb-0.fw-bold.text-dark Registrar Nueva Admisión
          .card-body.p-4
            if error && error.length > 0
              .alert.alert-danger= error

            form(action="/admisiones", method="POST")
              input#paciente-hidden-input(type="hidden", name="id_paciente")
              input#tipo-registro-input(type="hidden", name="tipo_registro")

              .card.mb-4
                .card-header.fw-bold 1. Datos del Paciente
                .card-body
                  .row.align-items-center
                    .col-md-8
                      label.form-label(for="paciente-select") Seleccionar Paciente
                      select.form-select#paciente-select
                        option(value="") -- Seleccionar o Registrar --
                        option(value="nuevo") -- Registrar Nuevo Paciente --
                        each p in pacientes
                          option(value=p.id_paciente, data-genero=p.genero)= `${p.nombre} ${p.apellido} (DNI: ${p.dni})`
                    .col-md-4.d-flex.justify-content-md-end.pt-3
                      .form-check.form-switch
                        input.form-check-input#es_emergencia(type="checkbox", name="es_emergencia")
                        label.form-check-label.fw-bold.text-danger(for="es_emergencia") Es Emergencia
              
              #nuevo-paciente-fields(style="display: none;")
                .card.mb-4
                  .card-header.fw-bold#nuevo-paciente-titulo Información del Nuevo Paciente
                  .card-body
                    .row.g-3
                      .col-md-6
                        label.form-label(for="genero-paciente-nuevo") Género (Obligatorio)
                        select.form-select#genero-paciente-nuevo(name="genero_paciente_nuevo")
                          option(value="") Seleccionar Género
                          option(value="Masculino") Masculino
                          option(value="Femenino") Femenino
                          option(value="Otro") Otro
                          option(value="No especificado") No especificado
                      
                      .col-md-6.campo-normal
                        label.form-label(for="nombre-paciente-nuevo") Nombre
                        input.form-control(type="text", name="nombre_paciente_nuevo", id="nombre-paciente-nuevo")
                      .col-md-6.campo-normal
                        label.form-label(for="apellido-paciente-nuevo") Apellido
                        input.form-control(type="text", name="apellido_paciente_nuevo", id="apellido-paciente-nuevo")
                      .col-md-6.campo-normal
                        label.form-label(for="dni-paciente-nuevo") DNI
                        input.form-control(type="text", name="dni_paciente_nuevo", id="dni-paciente-nuevo")
                      .col-md-6.campo-normal
                        label.form-label(for="fecha-nacimiento-nuevo") Fecha de Nacimiento
                        input.form-control(type="date", name="fecha_nacimiento_nuevo", id="fecha-nacimiento-nuevo")

              .card.mb-4
                .card-header.fw-bold 2. Detalles de la Admisión
                .card-body
                  textarea.form-control(name="motivo_internacion", placeholder="Describa el motivo de la internación...", required, rows="3")

              .card.mb-4
                .card-header.fw-bold 3. Asignación de Cama
                .card-body#cama-selection-container
                  .alert.alert-warning Seleccione un tipo de paciente y género para ver las camas disponibles.

              .d-flex.justify-content-end.mt-4
                a.btn.btn-secondary.me-2(href="/admisiones") Cancelar
                button.btn.btn-primary.btn-lg(type="submit") Guardar Admisión

    script.
      const camasData = !{JSON.stringify(camasDisponibles || [])};

      document.addEventListener('DOMContentLoaded', function () {
        const pacienteSelect = document.getElementById('paciente-select');
        const nuevoPacienteFields = document.getElementById('nuevo-paciente-fields');
        const generoNuevoSelect = document.getElementById('genero-paciente-nuevo');
        const pacienteHiddenInput = document.getElementById('paciente-hidden-input');
        const tipoRegistroInput = document.getElementById('tipo-registro-input');
        const emergenciaCheckbox = document.getElementById('es_emergencia');
        const camaContainer = document.getElementById('cama-selection-container');
        const camposNormales = document.querySelectorAll('.campo-normal');
        const nuevoPacienteTitulo = document.getElementById('nuevo-paciente-titulo');

        function updateFormState() {
          const selectedValue = pacienteSelect.value;
          const isEmergencia = emergenciaCheckbox.checked;
          let generoParaFiltrar = null;

          if (isEmergencia) {
              nuevoPacienteFields.style.display = 'block';
              pacienteSelect.disabled = true;
              pacienteSelect.value = '';
              camposNormales.forEach(el => el.style.display = 'none');
              nuevoPacienteTitulo.textContent = 'Información del Paciente de Emergencia';
              tipoRegistroInput.value = 'emergencia';
              pacienteHiddenInput.value = '';
              generoParaFiltrar = generoNuevoSelect.value;
          } else if (selectedValue === 'nuevo') {
              nuevoPacienteFields.style.display = 'block';
              pacienteSelect.disabled = false;
              camposNormales.forEach(el => el.style.display = 'block');
              nuevoPacienteTitulo.textContent = 'Información del Nuevo Paciente';
              tipoRegistroInput.value = 'nuevo';
              pacienteHiddenInput.value = '';
              generoParaFiltrar = generoNuevoSelect.value;
          } else if (selectedValue) {
              nuevoPacienteFields.style.display = 'none';
              pacienteSelect.disabled = false;
              pacienteHiddenInput.value = selectedValue;
              tipoRegistroInput.value = 'existente';
              const selectedOption = pacienteSelect.options[pacienteSelect.selectedIndex];
              generoParaFiltrar = selectedOption.dataset.genero;
          } else {
              nuevoPacienteFields.style.display = 'none';
              pacienteSelect.disabled = false;
              pacienteHiddenInput.value = '';
              tipoRegistroInput.value = '';
          }
          updateCamaOptions(generoParaFiltrar);
        }

        function updateCamaOptions(generoSeleccionado) {
          camaContainer.innerHTML = `
            <div class="row g-3">
              <div class="col-md-4"><label class="form-label" for="ala-select">Ala</label><select class="form-select" id="ala-select" disabled><option value="">-- Elija paciente/género --</option></select></div>
              <div class="col-md-4"><label class="form-label" for="habitacion-select">Habitación</label><select class="form-select" id="habitacion-select" disabled><option value="">-- Elija un ala --</option></select></div>
              <div class="col-md-4"><label class="form-label" for="cama-select">Cama</label><select class="form-select" id="cama-select" name="id_cama_asignada" disabled required><option value="">-- Elija una habitación --</option></select></div>
            </div>`;

          const newAlaSelect = document.getElementById('ala-select');
          const newHabitacionSelect = document.getElementById('habitacion-select');
          const newCamaSelect = document.getElementById('cama-select');

          if (!generoSeleccionado || !['Masculino', 'Femenino'].includes(generoSeleccionado)) {
            return;
          }

          const camasValidas = camasData.filter(cama => {
            const habitacion = cama.habitacion;
            if (habitacion.tipo !== 'Compartida') return true;
            const otraCamaOcupada = habitacion.camas.find(c => c.id_cama !== cama.id_cama && c.estado === 'Ocupada');
            if (!otraCamaOcupada) return true;
            const admision = otraCamaOcupada.admisiones[0];
            return admision && admision.paciente && admision.paciente.genero === generoSeleccionado;
          });

          if (camasValidas.length === 0) {
            camaContainer.innerHTML = '<div class="alert alert-info">No hay camas disponibles que cumplan los criterios para el género seleccionado.</div>';
            return;
          }

          newAlaSelect.innerHTML = '<option value="">-- Seleccione un Ala --</option>';
          const alasUnicas = [...new Map(camasValidas.map(cama => [cama.habitacion.ala.id_ala, cama.habitacion.ala])).values()];
          alasUnicas.forEach(ala => newAlaSelect.add(new Option(ala.nombre, ala.id_ala)));
          newAlaSelect.disabled = false;

          newAlaSelect.addEventListener('change', function() {
              newHabitacionSelect.innerHTML = '<option value="">-- Elija una habitación --</option>';
              newCamaSelect.innerHTML = '<option value="">-- Elija una habitación --</option>';
              newCamaSelect.disabled = true;
              if (this.value) {
                  const camasEnAla = camasValidas.filter(cama => cama.habitacion.id_ala == this.value);
                  const habitacionesUnicas = [...new Map(camasEnAla.map(cama => [cama.habitacion.id_habitacion, cama.habitacion])).values()];
                  habitacionesUnicas.forEach(hab => newHabitacionSelect.add(new Option(`${hab.numero} (${hab.tipo})`, hab.id_habitacion)));
                  newHabitacionSelect.disabled = false;
              }
          });

          newHabitacionSelect.addEventListener('change', function() {
              newCamaSelect.innerHTML = '<option value="">-- Elija una cama --</option>';
              if (this.value) {
                  const camasEnHabitacion = camasValidas.filter(cama => cama.habitacion.id_habitacion == this.value);
                  camasEnHabitacion.forEach(cama => newCamaSelect.add(new Option(cama.numero, cama.id_cama)));
                  newCamaSelect.disabled = false;
              }
          });
        }

        pacienteSelect.addEventListener('change', updateFormState);
        generoNuevoSelect.addEventListener('change', updateFormState);
        emergenciaCheckbox.addEventListener('change', updateFormState);

        updateFormState();
      });