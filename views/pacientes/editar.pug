extends ../layout

block content
  .container.mt-4
    if error && error.length > 0
      .alert.alert-danger.alert-dismissible.fade.show
        | #{error}
        button.btn-close(type="button", data-bs-dismiss="alert")
    
    .alert.alert-warning.shadow-sm.border-0
      i.fas.fa-exclamation-triangle.me-2
      | #[strong Módulo Administrativo:] Para editar información médica, recetas, alergias o registrar signos vitales, dirígete a la 
      a.fw-bold(href=`/pacientes/historia/${paciente.id_paciente}`) Historia Clínica
      |  del paciente.
    
    .card.shadow-sm.border-0.rounded-3
      .card-header.bg-primary.text-white.py-3
        h4.mb-0 Editar Datos Demográficos: #{paciente.nombre} #{paciente.apellido}
      
      .card-body.p-4
        form(action=`/pacientes/actualizar/${paciente.id_paciente}`, method="POST")
          .row.g-3
            .col-md-6
              label.form-label.fw-bold Nombre
              input.form-control(type="text", name="nombre", value=paciente.nombre, required)
            
            .col-md-6
              label.form-label.fw-bold Apellido
              input.form-control(type="text", name="apellido", value=paciente.apellido, required)
            
            .col-md-6
              label.form-label.fw-bold DNI
              input.form-control(type="text", name="dni", value=paciente.dni, required)
            
            .col-md-6
              label.form-label.fw-bold Fecha de Nacimiento
              - let fechaFormateada = ''
              - if (paciente.fecha_nacimiento) {
              -   try { fechaFormateada = new Date(paciente.fecha_nacimiento).toISOString().split('T')[0]; } catch(e) { fechaFormateada = paciente.fecha_nacimiento; }
              - }
              input.form-control(type="date", name="fecha_nacimiento", value=fechaFormateada, required)
            
            .col-md-6
              label.form-label.fw-bold Género
              select.form-select(name="genero", required)
                option(value="Masculino", selected=paciente.genero==='Masculino') Masculino
                option(value="Femenino", selected=paciente.genero==='Femenino') Femenino
                option(value="Otro", selected=paciente.genero==='Otro') Otro
            
            .col-md-6
              label.form-label.fw-bold Teléfono (Opcional)
              input.form-control(type="text", name="telefono", value=paciente.telefono)
            
            .col-md-6
              label.form-label.fw-bold Email (Opcional)
              input.form-control(type="email", name="email", value=paciente.email)
            
            .col-md-6
              label.form-label.fw-bold Dirección (Opcional)
              input.form-control(type="text", name="direccion", value=paciente.direccion)
            
            .col-md-6
              label.form-label.fw-bold Obra Social (Opcional)
              select.form-select(name="id_obra_social")
                option(value="") Particular
                if obrasSociales
                  each obra in obrasSociales
                    option(value=obra.id_obra_social, selected=paciente.id_obra_social===obra.id_obra_social) #{obra.nombre}
            
            .col-md-6
              label.form-label.fw-bold Número de Afiliado (Opcional)
              input.form-control(type="text", name="numero_afiliado", value=paciente.numero_afiliado)
            
            .col-12.mt-4
              .form-check.form-switch
                input.form-check-input#switchActivo(type="checkbox", name="activo", checked=paciente.activo !== false)
                label.form-check-label.fw-bold(for="switchActivo") Paciente Activo en el Sistema
          
          .card-footer.bg-white.text-end.mt-4.pb-0.pe-0.border-0
            a.btn.btn-secondary.me-2(href="/pacientes") Cancelar
            button.btn.btn-primary(type="submit") Actualizar Datos