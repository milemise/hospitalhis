extends ../layout

block content
  .container.mt-4
    if error && error.length > 0
      .alert.alert-danger.alert-dismissible.fade.show
        | #{error}
        button.btn-close(type="button", data-bs-dismiss="alert")

    .card.shadow-sm.border-0.rounded-3
      .card-header.bg-primary.text-white.py-3
        h4.mb-0 Registrar Nuevo Profesional Médico
      
      .card-body.p-4
        form(action="/medicos", method="POST")
          .row.g-3
            .col-md-4
              label.form-label.fw-bold DNI
              input.form-control(type="text", name="dni", placeholder="Ej: 35123456")
            
            .col-md-4
              label.form-label.fw-bold Nombre
              input.form-control(type="text", name="nombre", required)
            
            .col-md-4
              label.form-label.fw-bold Apellido
              input.form-control(type="text", name="apellido", required)
            
            .col-md-4
              label.form-label.fw-bold Fecha de Nacimiento
              input.form-control(type="date", name="fecha_nacimiento")
            
            .col-md-4
              label.form-label.fw-bold Género
              select.form-select(name="genero")
                option(value="") Seleccionar...
                option(value="Masculino") Masculino
                option(value="Femenino") Femenino
                option(value="Otro") Otro
            
            .col-md-4
              label.form-label.fw-bold Matrícula Profesional
              input.form-control(type="text", name="matricula", required, placeholder="Ej: MP12345")
            
            .col-md-6
              label.form-label.fw-bold Especialidad
              select.form-select(name="id_especialidad")
                option(value="") Seleccionar especialidad...
                if especialidades
                  each esp in especialidades
                    option(value=esp.id_especialidad) #{esp.nombre}
            
            .col-md-6
              label.form-label.fw-bold Teléfono
              input.form-control(type="text", name="telefono")
            
            .col-md-6
              label.form-label.fw-bold Email
              input.form-control(type="email", name="email")
            
            .col-md-6
              label.form-label.fw-bold Dirección
              input.form-control(type="text", name="direccion")
          
          .card-footer.bg-white.text-end.mt-4.pb-0.pe-0.border-0
            a.btn.btn-secondary.me-2(href="/medicos") Cancelar
            button.btn.btn-primary(type="submit") Guardar Profesional