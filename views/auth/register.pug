doctype html
html(lang="es")
  head
    meta(charset="UTF-8")
    meta(name="viewport", content="width=device-width, initial-scale=1.0")
    title Registro | HIS Hospital
    link(href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css", rel="stylesheet")
    link(rel="stylesheet", href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css")
    style.
      body { background-color: #cce5ff; min-height: 100vh; display: flex; align-items: center; justify-content: center; font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif; padding: 20px; }
      .login-card { background: white; border-radius: 35px; padding: 40px 30px; width: 100%; max-width: 450px; box-shadow: 0px 10px 25px rgba(0,0,0,0.05); }
      .form-control, .form-select { border-radius: 20px; background-color: #f4f9ff; border: 1px solid #cce5ff; padding: 10px 20px; font-size: 0.9rem;}
      .form-label { font-size: 0.85rem; color: #064082; font-weight: 700; margin-left: 10px; margin-bottom: 2px; }
      .btn-ingresar { background-color: #2ea3f2; color: white; border-radius: 25px; padding: 12px; font-weight: bold; border: none; font-size: 1rem; width: 100%; }
      .btn-ingresar:hover { background-color: #1c8cd6; color: white;}
      .main-title { color: #064082; font-weight: 800; font-size: 1.5rem; margin-bottom: 10px;}
  body
    .login-card
      .text-center
        h2.main-title Registro de Personal
        p.text-muted.small Crea tu cuenta para acceder al sistema
        
      if error && error.length > 0
        .alert.alert-danger.rounded-pill.text-center.small.py-2 #{error}

      form(action="/auth/register" method="POST")
        .mb-3
          label.form-label Nombre Completo
          input.form-control(type="text", name="nombre_usuario", placeholder="Ingrese su nombre", required)
        .mb-3
          label.form-label Correo / Usuario
          input.form-control(type="email", name="email", placeholder="correo@hospital.com", required)
        .mb-3
          label.form-label Contraseña
          input.form-control(type="password", name="password", placeholder="Cree una contraseña", required)
        .mb-4
          label.form-label Rol Asignado
          select.form-select(name="rol", required)
            option(value="", disabled, selected) Seleccionar Rol
            option(value="admin") Administrador
            option(value="admision") Admisión
            option(value="enfermeria") Enfermería
            option(value="medico") Médico
            option(value="limpieza") Limpieza
        
        .d-grid.gap-3
          button.btn.btn-ingresar(type="submit") Registrarme
          
      .text-center.mt-4
        a.text-decoration-none.small(href="/auth/login", style="color: #2ea3f2; font-weight: bold;") 
          i.fas.fa-arrow-left.me-1
          | Volver al Login