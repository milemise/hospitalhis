doctype html
html(lang="es")
  head
    meta(charset="UTF-8")
    meta(name="viewport", content="width=device-width, initial-scale=1.0")
    title Iniciar Sesión | HIS Hospital
    link(href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css", rel="stylesheet")
    link(rel="stylesheet", href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css")
    style.
      body { background-color: #cce5ff; height: 100vh; display: flex; align-items: center; justify-content: center; font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif; }
      .login-card { background: white; border-radius: 35px; padding: 50px 30px; width: 100%; max-width: 380px; box-shadow: 0px 10px 25px rgba(0,0,0,0.05); }
      .logo-container { width: 90px; height: 90px; border: 2px solid #2ea3f2; border-radius: 50%; display: flex; align-items: center; justify-content: center; margin: 0 auto 20px; flex-direction: column; background-color: white;}
      .logo-text { font-size: 0.7rem; font-weight: bold; color: #0d6efd; margin-top: -5px;}
      .form-control { border-radius: 20px; background-color: #f4f9ff; border: 1px solid #cce5ff; padding: 12px 20px; font-size: 0.9rem;}
      .form-label { font-size: 0.85rem; color: #064082; font-weight: 700; margin-left: 10px; margin-bottom: 5px; }
      .btn-ingresar { background-color: #2ea3f2; color: white; border-radius: 25px; padding: 12px; font-weight: bold; border: none; font-size: 1rem; }
      .btn-ingresar:hover { background-color: #1c8cd6; color: white;}
      .btn-registrarme { background-color: white; color: #2ea3f2; border: 2px solid #2ea3f2; border-radius: 25px; padding: 10px; font-weight: bold; font-size: 1rem; }
      .btn-registrarme:hover { background-color: #f4f9ff; color: #2ea3f2; }
      .main-title { color: #064082; font-weight: 800; font-size: 1.8rem; margin-bottom: 30px;}
  body
    .login-card
      .text-center
        .logo-container
          i.fas.fa-stethoscope.text-primary.fa-2x
          span.logo-text SistemHis
        h2.main-title HIS Hospital
        
      //- Mensajes de error o éxito
      if success && success.length > 0
        .alert.alert-success.rounded-pill.text-center.small.py-2 #{success}
      if error && error.length > 0
        .alert.alert-danger.rounded-pill.text-center.small.py-2 #{error}

      form(action="/auth/login" method="POST")
        .mb-3
          label.form-label Usuario
          input.form-control(type="email", name="email", placeholder="Ingrese su usuario", required)
        .mb-4
          label.form-label Contraseña
          input.form-control(type="password", name="password", placeholder="Ingrese su contraseña", required)
        
        .d-grid.gap-3.mt-2
          button.btn.btn-ingresar(type="submit") Ingresar
          a.btn.btn-registrarme(href="/auth/register") Registrarme