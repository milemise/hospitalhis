extends layout

block content
  //- Contenedor con un fondo degradado profesional de tono clínico
 .container-fluid.py-5(style="background: linear-gradient(rgba(0, 0, 0, 0.4), rgba(0, 0, 0, 0.4)), url('/images/hospital-bg.jpg'); background-size: cover; background-position: center; min-height: 85vh; display: flex; align-items: center;")
    .container
      .row.justify-content-center
        .col-lg-10
          //- Tarjeta principal con sombra pronunciada para que resalte sobre el fondo
          .card.border-0.shadow-lg.rounded-4.overflow-hidden.bg-white
            .card-body.p-5.text-center
              .mb-4
                i.fas.fa-hospital-symbol.fa-3x.text-primary.mb-3
                h2.fw-bold.text-dark Gestión Hospitalaria Profesional
                p.text-muted.lead.mx-auto(style="max-width: 600px;")
                  | Plataforma integral para la administración de internaciones, pacientes, admisiones y recursos médicos del sistema HIS.

              hr.w-25.mx-auto.my-4.text-muted

              //- Botones de Acceso Rápido Operativo
              .row.g-3.justify-content-center.mb-4
                .col-md-5
                  a.btn.btn-primary.btn-lg.w-100.py-3.shadow-sm.d-flex.align-items-center.justify-content-center(href="/admisiones")
                    i.fas.fa-user-plus.me-2.fa-lg
                    | Registrar Nueva Admisión
                .col-md-5
                  a.btn.btn-success.btn-lg.w-100.py-3.shadow-sm.d-flex.align-items-center.justify-content-center(href="/pacientes")
                    i.fas.fa-user-injured.me-2.fa-lg
                    | Registrar Nuevo Paciente

              //- Pie de estado de sesión
              .mt-4.pt-3.border-top.text-muted.small
                span.d-inline-block.bg-light.px-3.py-2.rounded-pill.border
                  i.fas.fa-user-circle.me-1.text-primary
                  | Sesión activa: 
                  strong.text-dark #{user ? user.nombre_usuario || user.email : 'Usuario'} 
                  |  (Rol: 
                  span.text-uppercase.fw-bold.text-primary #{user ? user.rol : 'Invitado'}
                  |)